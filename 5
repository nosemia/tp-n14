#include <iostream>
using namespace std;

class InstrumentoMusical {
public:
    virtual void tocar() = 0;
    virtual ~InstrumentoMusical() {}
};

class Piano : public InstrumentoMusical {
public:
    void tocar() override { cout << "El piano suena con acordes" << endl; }
};

class Guitarra : public InstrumentoMusical {
public:
    void tocar() override { cout << "La guitarra rasga las cuerdas" << endl; }
};

class Flauta : public InstrumentoMusical {
public:
    void tocar() override { cout << "La flauta suena suave" << endl; }
};

int main() {
    Piano p; Guitarra g; Flauta f;
    InstrumentoMusical* ins[] = { &p, &g, &f };
    for (InstrumentoMusical* i : ins) i->tocar();
}
